<?xml version="1.0" encoding="utf-8"?>
<project>

	<meta title="HaxeStackStarterServer" package="com.hackstack.starterserver" version="1.0.0" company="HaxeStack" />
	<app main="Main" path="Export" file="HaxeStackStarterServer" />

	<source path="Source" />
    <source path="../Shared" />
	
	<haxelib name="lime" />
    <haxelib name="SideWinder" />
    <haxelib name="snake-server" />
    <haxelib name="haxe-injection"/>
    <haxelib name="hxwell" />
    <haxelib name="json2object" />

    <haxedef name="disable_env" />
	
	<assets path="Assets" />
    <assets path="migrations" />
    <assets path="static" />
	
	<postbuild command="copy-server-hdlls.bat" if="hl" />
	<postbuild command="copy-server-hdlls.bat" if="hlc" />

</project>